        ],
        "measures": [
          {
            "name": "Pedidos entregues",
            "expression": "SUM('Mensal'[Quantidade])",
            "formatString": "#,##0"
          },
          {
            "name": "Pedidos aceitos",
            "expression": "CALCULATE([Pedidos entregues], KEEPFILTERS('Mensal'[Resultado] IN {\"Exato\", \"Até R$ 0,01\"}))",
            "formatString": "#,##0"
          },
          {
            "name": "Dentro da tolerância",
            "expression": "DIVIDE(COALESCE([Pedidos aceitos], 0), [Pedidos entregues])",
            "formatString": "0.00%"
          },
          {
            "name": "Casos na fila",
            "expression": "CALCULATE([Pedidos entregues], KEEPFILTERS(NOT ('Mensal'[Resultado] IN {\"Exato\", \"Até R$ 0,01\"})))",
            "formatString": "#,##0"
          },
          {
            "name": "Pedidos para revisão",
            "expression": "COALESCE([Casos na fila], 0)",
            "formatString": "#,##0"
          }
        ]
      },
